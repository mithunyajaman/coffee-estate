# Flask Configuration
FLASK_ENV=development
FLASK_DEBUG=1
SECRET_KEY=coffee-estate-super-secure-secret-key-replace-in-production

# Database Configuration (MySQL recommended; SQLite fallback supported)
# MySQL format: mysql+pymysql://<user>:<password>@<host>:<port>/<dbname>
DATABASE_URL=sqlite:///estate.db
# Uncomment to use local MySQL:
# DATABASE_URL=mysql+pymysql://root:yourpassword@localhost:3306/coffee_estate

# Rate Limiting & Security
RATELIMIT_DEFAULT=200 per day;50 per hour
RATELIMIT_STORAGE_URI=memory://
SESSION_COOKIE_HTTPONLY=True
SESSION_COOKIE_SAMESITE=Lax

# Uploads
UPLOAD_FOLDER=./uploads
MAX_CONTENT_LENGTH=16777216
